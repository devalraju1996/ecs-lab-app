{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEcsLabSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "PASTE-YOUR-SECRET-ARN-HERE"
    },
    {
      "Sid": "CreateLogGroupIfMissing",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:700017004782:log-group:/ecs/ecs-lab*"
    }
  ]
}
